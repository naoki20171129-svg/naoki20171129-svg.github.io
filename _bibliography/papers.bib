@article{yagihara2026microgravity,
  bibtex_show = {true},
  abbr = {bioRxiv},
  title = {Effects of microgravity on the three-dimensional morphology of rhizoids in Physcomitrium patens},
  author = {Yagihara, Naoki and Wakabayashi, Takahisa and Yamaura, Ryohei and Tamaoki, Daisuke and Kamachi, Hiroyuki and Yamauchi, Daisuke and Mineyuki, Yoshinobu and Hoshino, Makoto and Uesugi, Kentaro and Shimazu, Toru and Kasahara, Haruo and Kamada, Motoshi and Suzuki, Tomomi and Hiwatashi, Yuji and Hanba, Yuko and Kume, Atsushi and Fujita, Tomomichi and Karahara, Ichirou},
  journal = biorxiv,
  year = {2026},
  doi = {10.64898/2026.01.30.702759},
  html = {https://www.biorxiv.org/content/10.64898/2026.01.30.702759},
  note = {Preprint},
  abstract = {Rooting systems of plants perceive environmental stimuli and flexibly regulate their growth. Analyzing rhizoid morphology under microgravity, where gravitational effects are largely eliminated, provides an effective approach to examine the gravity-response mechanisms that evolved after terrestrialization. To elucidate microgravity effects on rhizoid growth of Physcomitrium patens, we analyzed 3D datasets obtained by refraction-contrast micro-CT using synchrotron radiation after fixation and embedding of samples from the Space Moss experiment conducted on the International Space Station. We optimized a WEKA-based machine-learning segmentation approach, and morphological analyses revealed that, compared with both ground and artificial 1 × g conditions, rhizoid elongation and gravitropic responses were suppressed under microgravity, leading to reduced vertical growth.},
}
